# Copie este archivo como .env y cambie los valores antes de levantar el sistema en el servidor.
# Clave de la base: en el servidor, use una clave larga y distinta de la de ejemplo.
POSTGRES_USER=indicadores
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_DB=indicadores
# Dirección en la que escucha la web: 127.0.0.1 (solo el propio servidor, detrás de un proxy con HTTPS) o 0.0.0.0 (toda la red).
ENLACE=127.0.0.1
PUERTO_WEB=8080
PUERTO_API=8000
# Dirección con la que los usuarios abren la web (para CORS), por ejemplo https://indicadores.servidor-del-profesor.cl
CORS_ORIGENES=http://localhost:8080
